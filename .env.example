# Copy to .env and fill in real values. Never commit .env.

# Neon PostgreSQL — pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seed-only: password for the bootstrap `admin` user.
ADMIN_PASSWORD=""

# Cloudinary (student photos). Server-side uploads only — the API secret must
# never reach the browser, so none of these are NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
