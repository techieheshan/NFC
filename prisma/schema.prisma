// ============================================================================
// XENON INSTITUTE — Attendance / Payment / Payroll System
// Prisma schema (PostgreSQL / Neon)
//
// This is the FOUNDATION CONTRACT. Every feature (tag) builds against it.
// Design rules baked in:
//   1. Anything the institute can reword / re-price / add later = a real table
//      (Stream, Subject, Grade, ClassType, FeeTier, ExpenseType, Setting),
//      NOT a hardcoded enum. Only structural, never-changing things are enums.
//   2. Every table carries updatedAt -> makes the future cloud->on-prem sync
//      possible. Do not remove these.
//   3. Money = Decimal (never Float). Percentages = Decimal(5,2).
//   4. Times of day stored as "HH:mm" strings; attendance windows stored as
//      minute offsets so they're trivial to compute against "now".
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` / `directUrl` here. Connection URLs live in
// `prisma.config.ts` (migrations, via DIRECT_URL) and in the driver adapter
// passed to PrismaClient (runtime, via the pooled DATABASE_URL).
// See src/lib/db.ts. This is the ONLY change made to the provided schema.
datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS — structural only. These never change with institute policy.
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  TEACHER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

// Payment KIND is structural (the app treats each shape differently).
// Do not confuse with editable business values like FeeTier / ExpenseType.
enum PaymentKind {
  ADMISSION // one-time, ever
  SMART_CARD // charged each time a card is issued (incl. lost-card reissue)
  CLASS // monthly per-course fee (tiers + combos apply here)
}

// How much of a month's fee one CLASS payment row charges. NULL means the full fee
// (every row written before this existed, and every row the old screens write), so the
// column is additive: nothing existing changes meaning.
enum ChargeMode {
  HALF // 50% of what would otherwise be charged for that month (after tier and combo)
  NO_CHARGE // the month is recorded as settled with no money: a real row, amount 0.00
}

enum AttendanceMethod {
  NFC
  QR
  SEARCH
}

// ----------------------------------------------------------------------------
// REFERENCE TABLES — institute-configurable. Add/edit rows without code changes.
// `code` gives app logic a stable handle; `label` is what staff see/edit.
// ----------------------------------------------------------------------------

model Stream {
  id        Int      @id @default(autoincrement())
  label     String   @unique // Science, Maths, Tech, Commerce, Art, 6-11, Primary, A/L, Other
  active    Boolean  @default(true)
  courses   Course[]
  /// Which subjects this stream offers. Many-to-many on purpose: ICT belongs
  /// to A/L Tech AND A/L Arts, and registration narrows the subject list by
  /// stream. Grade is deliberately NOT part of this — a student may sit in
  /// another grade's class to catch up.
  subjects  Subject[] @relation("StreamSubjects")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A classroom. Reference data like Subject/Grade — renamed and deactivated,
/// never deleted, because schedules and past allocations point at it.
model Hall {
  id     Int     @id @default(autoincrement())
  name   String  @unique // Blue Sky, Picasso, Tesla, ...
  icon   String // a key into HALL_ICONS (src/lib/hall-icons.ts), not a URL
  active Boolean @default(true)

  schedules         Schedule[]
  additionalClasses AdditionalClass[]
  overrides         HallAllocationOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One day's exception to where a class meets. The schedule's own
/// `defaultHallId` is never touched by a reassignment — resolution is
/// "override for this date, else the default" and lives in one helper
/// (`hallForClassOnDate`).
model HallAllocationOverride {
  id   Int      @id @default(autoincrement())
  date DateTime @db.Date

  // Exactly one of these two is set: a recurring class or a one-off.
  schedule          Schedule?        @relation(fields: [scheduleId], references: [id])
  scheduleId        Int?
  additionalClass   AdditionalClass? @relation(fields: [additionalClassId], references: [id])
  additionalClassId Int?

  hall   Hall @relation(fields: [hallId], references: [id])
  hallId Int

  createdBy   User   @relation("HallOverrideBy", fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())

  // One class resolves to exactly one hall on one date.
  @@unique([date, scheduleId])
  @@unique([date, additionalClassId])
  @@index([date])
}

model Subject {
  id        Int      @id @default(autoincrement())
  label     String   @unique // ICT, Chemistry, BTECH, ETECH, ...
  active    Boolean  @default(true)
  courses   Course[]
  /// The streams that offer this subject. See Stream.subjects.
  streams   Stream[] @relation("StreamSubjects")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grade {
  id        Int      @id @default(autoincrement())
  label     String   @unique // "A/L 2027", "A/L 2026", "Grade 11", "Primary", ...
  active    Boolean  @default(true)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassType {
  id        Int      @id @default(autoincrement())
  code      String   @unique // THEORY | PAPER | REVISION (extensible)
  label     String
  active    Boolean  @default(true)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Full / Half / 25% / Free — multiplier applied to the payable base fee.
// e.g. FULL=1.000, HALF=0.500, QUARTER=0.250, FREE=0.000
model FeeTier {
  id          Int          @id @default(autoincrement())
  code        String       @unique // FULL | HALF | QUARTER | FREE
  label       String
  multiplier  Decimal      @db.Decimal(4, 3)
  active      Boolean      @default(true)
  enrollments Enrollment[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Two types today: TEACHER_ADVANCE and XENON. Addable later.
// affectsTeacherPayslip = true only for TEACHER_ADVANCE (deducts from that
// teacher's salary in THIS system). XENON only reduces institute profit;
// staff advances live inside XENON (flagged on the Expense row).
model ExpenseType {
  id                    Int       @id @default(autoincrement())
  code                  String    @unique // TEACHER_ADVANCE | XENON
  label                 String
  affectsTeacherPayslip Boolean   @default(false)
  active                Boolean   @default(true)
  expenses              Expense[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Editable global values so nothing money-related is hardcoded:
//   admission_fee, smart_card_fee, default_institute_fee,
//   institute_share_presets ("20,25,30"), etc.
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// PEOPLE & AUTH
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)

  // --- Auth hardening. All four are DB-backed on purpose: the on-prem box may
  // run more than one instance and will be restarted, so a lockout or a
  // revocation held in process memory would simply evaporate.
  //
  // Bumped to revoke every JWT already issued to this user. The token carries
  // the version it was minted with; a mismatch ends the session on the next
  // request. This is what makes a stateless JWT revocable.
  tokenVersion       Int       @default(0)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  // Set when an admin creates the account or resets the password: the person
  // who chose that password is not the person who should keep using it.
  mustChangePassword Boolean   @default(false)

  // A login may belong to one Teacher (to view own payslip) or one Staff.
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId Int?     @unique
  staff     Staff?   @relation(fields: [staffId], references: [id])
  staffId   Int?     @unique

  // Audit back-references (who did what)
  paymentsTaken     Payment[]    @relation("PaymentTakenBy")
  paymentsCancelled Payment[]    @relation("PaymentCancelledBy")
  attendanceMarked  Attendance[] @relation("AttendanceMarkedBy")
  expensesRecorded  Expense[]    @relation("ExpenseRecordedBy")
  hallOverridesSet  HallAllocationOverride[] @relation("HallOverrideBy")
  expensesAuthorized Expense[]   @relation("ExpenseAuthorizedBy")

  // Daily Summary Release 2 (back-relations only: no column on "User")
  dsVersionsDone      DailySummaryVersion[]  @relation("DsDoneBy")
  dsVersionsPrepared  DailySummaryVersion[]  @relation("DsPreparedBy")
  dsVersionsSaved     DailySummaryVersion[]  @relation("DsSavedBy")
  dsBankLinesRecorded DailySummaryBankLine[] @relation("DsBankRecordedBy")
  dsChecksAsChecker   DailySummaryCheck[]    @relation("DsCheckedBy")
  dsChecksMarked      DailySummaryCheck[]    @relation("DsCheckMarkedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Teacher {
  id       Int       @id @default(autoincrement())
  name     String
  nic      String?
  phone    String?
  joinDate DateTime? @db.Date
  active   Boolean   @default(true)

  user     User?
  courses  Course[]
  combos   Combo[]
  advances Expense[] // TEACHER_ADVANCE rows pointing at this teacher

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Staff = name only, for tagging advances (staff payroll is handled by a
// SEPARATE system — no salary, no payslip here). May optionally have a login.
model Staff {
  id     Int     @id @default(autoincrement())
  name   String
  nic    String?
  phone  String?
  active Boolean @default(true)

  user     User?
  advances Expense[] // XENON rows flagged isStaffAdvance, pointing here

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id            Int     @id @default(autoincrement())
  name          String
  address       String?
  school        String?
  phone         String?
  nic           String?
  photoUrl      String? // S3-compatible object key/URL, compressed ~400px
  cardUid       String? @unique // current active NFC UID; overwritten on reissue
  cardNumber    String? @unique // printed on the card + encoded in its QR, e.g. "0186-0001-2000"
  admissionPaid Boolean @default(false) // one-time admission fee flag

  enrollments Enrollment[]
  attendances Attendance[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardUid])
}

// ----------------------------------------------------------------------------
// COURSES / SCHEDULES
// A Course is the ENROLLABLE unit: one teacher + subject + grade + class-type.
// So "A/L 2027 ICT Theory (Mr.X)" and "...Paper (Mr.X)" are two Courses.
// ----------------------------------------------------------------------------

model Course {
  id   Int     @id @default(autoincrement())
  name String? // optional display label; can be composed

  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  teacherId   Int
  subject     Subject   @relation(fields: [subjectId], references: [id])
  subjectId   Int
  grade       Grade     @relation(fields: [gradeId], references: [id])
  gradeId     Int
  stream      Stream    @relation(fields: [streamId], references: [id])
  streamId    Int
  classType   ClassType @relation(fields: [classTypeId], references: [id])
  classTypeId Int

  defaultFee            Decimal @db.Decimal(10, 2)
  // Institute's cut of collected money for THIS course (20/25/30... custom).
  instituteSharePercent Decimal @db.Decimal(5, 2)
  // Optional flat institute fee (present but may be 0 / unused for now).
  instituteFee          Decimal @default(0) @db.Decimal(10, 2)
  active                Boolean @default(true)

  schedules         Schedule[]
  additionalClasses AdditionalClass[]
  enrollments       Enrollment[]
  comboItems        ComboItem[]
  attendances       Attendance[]
  payments          Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

// Recurring weekly timetable entry. A course can have several (Tue AND Fri).
model Schedule {
  id        Int       @id @default(autoincrement())
  course    Course    @relation(fields: [courseId], references: [id])
  courseId  Int
  dayOfWeek DayOfWeek
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  // Attendance opens (start - openBefore) and closes (end - closeBefore).
  attendanceOpensBeforeMin  Int     @default(30) // e.g. 30 -> opens 2:30 for a 3:00 class
  attendanceClosesBeforeMin Int     @default(30) // e.g. 30 -> closes 4:30 for a 5:00 end
  active                    Boolean @default(true)

  // Where this class usually meets. Nullable: a schedule may predate halls, or
  // simply not have a room yet — it then resolves to "unassigned".
  defaultHall   Hall? @relation(fields: [defaultHallId], references: [id])
  defaultHallId Int?

  hallOverrides HallAllocationOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, dayOfWeek])
}

// One-off dated session (e.g. Poya 8-10 PM). Never recurs. Always tied to a
// Course (inherits its roster). Not billed — attendance + summary only.
model AdditionalClass {
  id                        Int      @id @default(autoincrement())
  course                    Course   @relation(fields: [courseId], references: [id])
  courseId                  Int
  date                      DateTime @db.Date
  startTime                 String // "HH:mm"
  endTime                   String // "HH:mm"
  attendanceOpensBeforeMin  Int      @default(30)
  attendanceClosesBeforeMin Int      @default(30)
  note                      String?

  // Set when the one-off class is created, so it appears in allocation and the
  // timetable with no second step.
  hall   Hall? @relation(fields: [hallId], references: [id])
  hallId Int?

  attendances   Attendance[]
  hallOverrides HallAllocationOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, date])
}

// ----------------------------------------------------------------------------
// ENROLLMENT — Student x Course, with per-enrollment fee tier (forward-only).
// ----------------------------------------------------------------------------

model Enrollment {
  id        Int              @id @default(autoincrement())
  student   Student          @relation(fields: [studentId], references: [id])
  studentId Int
  course    Course           @relation(fields: [courseId], references: [id])
  courseId  Int
  feeTier   FeeTier          @relation(fields: [feeTierId], references: [id])
  feeTierId Int
  status    EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId]) // enroll in a given course once
  @@index([courseId])
}

// ----------------------------------------------------------------------------
// ATTENDANCE — one row per student per class session.
// additionalClassId set => it was the one-off session (else recurring class).
// ----------------------------------------------------------------------------

model Attendance {
  id                Int              @id @default(autoincrement())
  student           Student          @relation(fields: [studentId], references: [id])
  studentId         Int
  course            Course           @relation(fields: [courseId], references: [id])
  courseId          Int
  additionalClass   AdditionalClass? @relation(fields: [additionalClassId], references: [id])
  additionalClassId Int?
  date              DateTime         @db.Date
  method            AttendanceMethod
  markedBy          User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedById        String
  markedAt          DateTime         @default(now())
  // Client-generated id so the coming offline sync can replay a queued mark
  // without creating duplicates. Unique => the second attempt is a no-op.
  clientRef         String           @unique

  // No @@unique here: Postgres treats NULLs as DISTINCT, so a unique across a
  // nullable additionalClassId would NOT block duplicate marks on regular
  // classes. "Already marked?" is enforced in app logic before insert.
  @@index([courseId, date])
  @@index([studentId, date])
  @@index([studentId, courseId, date])
}

// ----------------------------------------------------------------------------
// COMBOS — staff-created. A student QUALIFIES by being enrolled in EVERY course
// of the combo (same teacher). At payment the system uses the combo matching
// the student's full enrolled set for that teacher and OFFERS it (pop-up).
// ----------------------------------------------------------------------------

model Combo {
  id        Int     @id @default(autoincrement())
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId Int
  name      String // "2027 Chemistry Theory+Paper"
  active    Boolean @default(true)

  items    ComboItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
}

model ComboItem {
  id       Int     @id @default(autoincrement())
  combo    Combo   @relation(fields: [comboId], references: [id])
  comboId  Int
  course   Course  @relation(fields: [courseId], references: [id])
  courseId Int
  comboFee Decimal @db.Decimal(10, 2) // discounted per-course fee inside this combo

  @@unique([comboId, courseId])
}

// ----------------------------------------------------------------------------
// PAYMENTS — one table for all money in (easy daily-cash summation).
// kind = ADMISSION | SMART_CARD | CLASS.
//   ADMISSION  : one-time; amount only.
//   SMART_CARD : per issuance; cardUidIssued records the new UID.
//   CLASS      : course + billing month; tier + combo audit fields apply.
// amount is the FINAL charged figure (snapshotted; past payments never change).
// ----------------------------------------------------------------------------

model Payment {
  id        Int         @id @default(autoincrement())
  kind      PaymentKind
  student   Student     @relation(fields: [studentId], references: [id])
  studentId Int
  amount    Decimal     @db.Decimal(10, 2)

  // CLASS-only fields
  course       Course?  @relation(fields: [courseId], references: [id])
  courseId     Int?
  billingYear  Int? // e.g. 2026
  billingMonth Int? // 1..12
  feeTier      FeeTier? @relation(fields: [feeTierId], references: [id])
  feeTierId    Int?
  // The institute's cut FROZEN at the moment of payment. Course.instituteSharePercent
  // can be edited later; without this, changing it would silently rewrite every
  // past payslip. Null on ADMISSION/SMART_CARD (no split) and on legacy rows.
  instituteSharePercentApplied Decimal? @db.Decimal(5, 2)

  // CLASS only. NULL = the full fee. HALF / NO_CHARGE: see the ChargeMode enum.
  // A NO_CHARGE row is a normal CLASS row with amount 0.00, so SETTLED_PAYMENT_WHERE
  // sees it and the month is settled. NEVER filter with `chargeMode: { not: ... }`:
  // in SQL that drops the NULL rows, which are almost all of them.
  chargeMode ChargeMode?

  // Combined-payment audit (CLASS only). If combo applied, comboId set +
  // comboApplied true. If refused by staff, comboApplied false + reason REQUIRED.
  // comboId set + comboApplied false + reason NULL = the combo was SWITCHED OFF by
  // staff for that payment (normal rate, no reason asked). comboId NULL on a
  // NO_CHARGE row: that month is outside the combo whatever the student qualifies for.
  combo              Combo?  @relation(fields: [comboId], references: [id])
  comboId            Int?
  comboApplied       Boolean @default(false)
  comboRefusedReason String?

  // SMART_CARD-only
  cardUidIssued String?

  // Cancellation (admin-only feature)
  cancelled     Boolean   @default(false)
  cancelledBy   User?     @relation("PaymentCancelledBy", fields: [cancelledById], references: [id])
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?

  takenBy   User     @relation("PaymentTakenBy", fields: [takenById], references: [id])
  takenById String
  paidAt    DateTime @default(now())

  // Groups every row written by ONE checkout. A combo across three courses, or
  // a three-month catch-up, is a single receipt — reprinting has to reproduce
  // that document, not one line of it, and cancelling voids it as a unit.
  // Null only on rows written before this column existed, until the backfill.
  transactionRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NOTE: no unique on (student, course, month) — a cancelled payment must be
  // re-payable. "Already paid this month?" is checked in app logic over
  // non-cancelled rows.
  @@index([studentId])
  @@index([courseId, billingYear, billingMonth])
  @@index([paidAt])
  @@index([kind])
  @@index([transactionRef])
}

// ----------------------------------------------------------------------------
// EXPENSES — reduce daily cash. Two types via ExpenseType:
//   TEACHER_ADVANCE : linked to a teacher; deducted from that teacher's payslip
//                     for the month it was taken. NOT part of institute profit.
//   XENON           : reduces institute profit. Staff advances live here,
//                     flagged isStaffAdvance + staffId (for the manual-deduct
//                     report in the separate staff-payroll system). Counted
//                     once, as a normal Xenon expense — no double counting.
// ----------------------------------------------------------------------------

model Expense {
  id            Int         @id @default(autoincrement())
  type          ExpenseType @relation(fields: [expenseTypeId], references: [id])
  expenseTypeId Int
  amount        Decimal     @db.Decimal(10, 2)
  reason        String
  date          DateTime    @db.Date

  // TEACHER_ADVANCE
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  teacherId Int?

  // XENON that is a staff advance
  isStaffAdvance Boolean @default(false)
  staff          Staff?  @relation(fields: [staffId], references: [id])
  staffId        Int?

  recordedBy   User   @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  recordedById String

  // Who gave permission for this spend — usually an admin, sometimes staff.
  // Recorded, not a live approval handshake: the person at the keyboard states
  // who authorised it, and every screen that shows the expense shows this too.
  // Required; rows predating the column were backfilled with `recordedById`.
  authorizedBy   User   @relation("ExpenseAuthorizedBy", fields: [authorizedById], references: [id])
  authorizedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([expenseTypeId])
  @@index([teacherId])
}

// ----------------------------------------------------------------------------
// DAILY SUMMARY, SAVED DAYS (Release 2). ADDITIVE: new enum and tables only.
//
// A day is SAVED only when someone taps "Save day". Every save, edit or re-save writes a NEW
// immutable DailySummaryVersion: a full frozen snapshot of the document's inputs plus the cash
// book in Decimal(12,2). Versions are never updated. Bank deposits are rows of their own, copied
// into every version (a version is complete on its own, and deleting a day deletes them with it).
// "Checked by" is a row that belongs to ONE version: a money change makes a new version with no
// check. Rows are kept 3 months after the DATE of the day, then deleted (lazy purge); payments
// and expenses are never touched.
// ----------------------------------------------------------------------------

enum DailySummarySaveKind {
  SAVE // version 1: the day was saved
  EDIT // bring-forward or bank lines changed; the frozen numbers were kept
  RESAVE_LIVE // saved again with the live numbers
}

model DailySummaryDay {
  id Int @id @default(autoincrement())
  // The Colombo calendar day (colomboDateValue). ONE saved day per date.
  date DateTime @unique @db.Date
  // Number of the newest version: the optimistic-concurrency token (compared under a per-day lock).
  currentVersion Int

  versions DailySummaryVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailySummaryVersion {
  id      Int                  @id @default(autoincrement())
  day     DailySummaryDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId   Int
  version Int // 1, 2, 3 ... within the day
  kind    DailySummarySaveKind

  // The cash book of THIS version (rule 4: Decimal, never Float; 99,999,999.99 is the largest typed amount).
  bringForward     Decimal @db.Decimal(12, 2)
  collected        Decimal @db.Decimal(12, 2)
  deductions       Decimal @db.Decimal(12, 2)
  shouldBeInDrawer Decimal @db.Decimal(12, 2)
  bankTotal        Decimal @db.Decimal(12, 2)
  leftInDrawer     Decimal @db.Decimal(12, 2)
  net              Decimal @db.Decimal(12, 2)

  // The frozen inputs of the A4 document and of the saved-vs-live comparison:
  // { report: DailySummary, cancelled, staff }. Written once, never changed. snapshotSchema
  // says which shape it is, so a later release can still read this one.
  snapshot       Json
  snapshotSchema Int  @default(1)

  // Structured change items (what changed from the previous version), rendered to text on screen.
  changes Json

  // Done by of THIS version: who did this save, edit or re-save. Required every time.
  doneBy     User   @relation("DsDoneBy", fields: [doneById], references: [id])
  doneById   String
  doneByName String // frozen text
  // Done by of version 1, carried unchanged into every later version. Never edited.
  preparedBy     User   @relation("DsPreparedBy", fields: [preparedById], references: [id])
  preparedById   String
  preparedByName String // frozen text
  // The signed-in user who tapped Save (audit).
  savedBy   User     @relation("DsSavedBy", fields: [savedById], references: [id])
  savedById String
  savedAt   DateTime @default(now())

  bankLines DailySummaryBankLine[]
  check     DailySummaryCheck?

  @@unique([dayId, version])
}

model DailySummaryBankLine {
  id        Int                 @id @default(autoincrement())
  version   DailySummaryVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId Int
  position  Int // 1..10, the order shown
  time      String // "HH:mm", Colombo (rule: times of day are strings)
  amount    Decimal @db.Decimal(12, 2)
  slip      String  @default("")
  note      String  @default("")
  // Done by of the version that ADDED this deposit. A later version that keeps the line (or edits only its
  // time, slip or note) carries recordedBy and recordedAt over unchanged.
  recordedBy   User     @relation("DsBankRecordedBy", fields: [recordedById], references: [id])
  recordedById String
  recordedAt   DateTime

  @@unique([versionId, position])
}

model DailySummaryCheck {
  id        Int                 @id @default(autoincrement())
  version   DailySummaryVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  versionId Int                 @unique
  // The ACTIVE ADMIN named (printed on the signature box) ...
  checkedBy     User   @relation("DsCheckedBy", fields: [checkedById], references: [id])
  checkedById   String
  checkedByName String // frozen text
  // ... and the ADMIN or STAFF user who tapped "Mark as checked".
  markedBy     User   @relation("DsCheckMarkedBy", fields: [markedById], references: [id])
  markedById   String
  markedByName String // frozen text
  checkedAt    DateTime @default(now())
  // Set when a later version kept the same money (only slip, note, time or order changed) and the check was carried over.
  carriedFromVersion Int?
}
