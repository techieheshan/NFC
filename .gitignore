# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets.
# .env holds live Neon, Auth.js and Cloudinary credentials.
.env*
# ...but the blank-valued template is meant to be committed.
!.env.example

# vercel
.vercel

# Source documents (specs, screenshots of the live WST system). Kept local:
# they contain the production admin URL, an operator username, real teacher
# names and fee amounts, none of which belongs in a public repo.
/doc/
/doc.zip

# typescript
*.tsbuildinfo
next-env.d.ts
